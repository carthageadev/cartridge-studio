{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ss.ts": { "maxDuration": 60 },
    "api/config.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api2/:slug*", "destination": "/api/ss?slug=:slug*" }
  ]
}