# Server-only values. Read by the functions under /api and by the local dev
# proxy in vite.config.ts. Never prefix these with VITE_.
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=
SCREENSCRAPER_SOFT_NAME=CartridgeFlow

# Optional remote base URL for the 3D assets. Left empty, the bundled files
# in /public are served instead.
THREE_D_BASE_URL=