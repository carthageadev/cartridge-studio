VITE_SCREENSCRAPER_DEV_ID=
VITE_SCREENSCRAPER_DEV_PASSWORD=
VITE_SCREENSCRAPER_SOFT_NAME=
# Server-only configuration. All values are returned at runtime by /api/config
# so the browser can load the 3D assets. Nothing is baked into the frontend bundle.
# Example (Internet Archive):
THREE_D_BASE_URL=https://archive.org/download/7535476
THREE_D_MODEL=model.glb
THREE_D_BODY_BASE=diffuse.jpg
THREE_D_BODY_NORMAL=normal.png
THREE_D_BODY_ROUGHNESS=roughness.png
